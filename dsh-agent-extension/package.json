{
  "name": "dsh-agent",
  "displayName": "Zao Agent",
  "description": "AI-first agent panel for Zao, backed by the DeepSeek Harness (DSH) gateway.",
  "version": "0.1.0",
  "publisher": "zao",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onView:dshAgent.view"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshAgent",
          "title": "AI",
          "icon": "media/ai.svg"
        }
      ]
    },
    "views": {
      "dshAgent": [
        {
          "type": "webview",
          "id": "dshAgent.view",
          "name": "AI 对话"
        }
      ]
    },
    "commands": [
      {
        "command": "dshAgent.openFile",
        "title": "Zao: 打开文件（右分屏）"
      },
      {
        "command": "dshAgent.toggleEdit",
        "title": "Zao: 切换当前文件只读/可编辑"
      },
      {
        "command": "dshAgent.togglePureLayout",
        "title": "Zao: 切换极简 AI 布局"
      }
    ],
    "configuration": {
      "title": "Zao AI",
      "properties": {
        "dshAgent.gatewayBase": {
          "type": "string",
          "default": "http://127.0.0.1:3080",
          "description": "DSH apiproxy gateway base URL."
        },
        "dshAgent.gatewayCommand": {
          "type": "string",
          "default": "",
          "description": "用于自动启动网关的 dsh 命令（留空则自动探测：PATH 上的 dsh → npx 缓存 → npm exec）。"
        },
        "dshAgent.autoAllowTools": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "自动放行的工具名列表，无需逐次确认。"
        },
        "dshAgent.pureAILayout": {
          "type": "boolean",
          "default": true,
          "description": "极简 AI 布局：隐藏活动栏/状态栏/资源管理器，只保留 AI 对话（diff 按需打开）。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run",
    "lint": "eslint src",
    "fmt": "prettier --write \"src/**/*.ts\"",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  }
}
